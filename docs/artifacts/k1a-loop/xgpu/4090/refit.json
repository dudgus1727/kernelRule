    "code": "def score(f, p, hw, w):\n    # Width-1 raster tie-break: use the shorter output dimension as the fast raster side.\n    if p.M > p.N:\n        d = f.dram_w1_hz_ratio\n        sgn = 1.0\n    else:\n        d = f.dram_w1_id_ratio\n        sgn = -1.0\n\n    # Common compute/L2 roof and the explicit split-K and family corrections retained from the parent.\n    sm = np.maximum(f.tm_crit_ratio, f.tm_l2_ratio)\n    t = np.sqrt(np.square(sm) + np.square(d))\n    s = 10.0 * np.log2(t)\n    s = s + w[0] * f.tm_regstaged + w[1] * f.tm_cta_warps\n    s = s + w[2] * f.splitk_roofline_log_time\n    s = s + 0.001 * sgn * f.tm_log_inst\n\n    # tm_regstaged=1 identifies the register-staged two-stage family; its complement\n    # identifies multistage kernels.  Resource costs are fitted separately for the\n    # two families because the same allocation has a different latency-hiding trade.\n    two_stage = f.tm_regstaged\n    multistage = 1.0 - f.tm_regstaged\n    if p.roofline_ratio < 1:\n        # Memory-bound kernels additionally pay for the latency-critical SM path.\n        s = s + w[3] * two_stage * f.register_file_pressure\n        s = s + w[4] * two_stage * f.shared_memory_pressure\n        s = s + w[5] * two_stage * f.resident_block_scarcity\n        s = s + w[6] * multistage * f.pipeline_fill_drain_fraction\n        s = s + w[7] * multistage * f.register_file_pressure\n        s = s + w[8] * multistage * f.shared_memory_pressure\n        s = s + w[9] * multistage * f.resident_block_scarcity\n        s = s + w[10] * f.splitk_sm_latency_rounds_log\n    else:\n        # Compute-bound kernels expose stage prologue/epilogue and occupancy/resource\n        # costs, but do not use the memory-only latency-round correction.\n        s = s + w[11] * two_stage * f.register_file_pressure\n        s = s + w[12] * two_stage * f.shared_memory_pressure\n        s = s + w[13] * two_stage * f.resident_block_scarcity\n        s = s + w[14] * multistage * f.pipeline_fill_drain_fraction\n        s = s + w[15] * multistage * f.register_file_pressure\n        s = s + w[16] * multistage * f.shared_memory_pressure\n        s = s + w[17] * multistage * f.resident_block_scarcity\n    return s",
