    "code": "def score(f, p, hw, w):\n    # Width-1 raster tie-break: use the shorter output-grid direction for the\n    # visible raster model, while retaining the fixed-sign instruction tie-break.\n    if p.M > p.N:\n        d = f.dram_w1_hz_ratio\n        sgn = 1.0\n    else:\n        d = f.dram_w1_id_ratio\n        sgn = -1.0\n\n    sm = np.fmax(f.tm_crit_ratio, f.tm_l2_ratio)\n    t = np.sqrt(np.square(sm) + np.square(d))\n    s = 10.0 * np.log2(t)\n    s = s + w[0] * f.tm_regstaged + w[1] * f.tm_cta_warps\n\n    if p.log_min_dim < 5 or p.output_work_per_sm < 128:\n        s = s + w[2] * np.log2(1.0 + f.edge_waste)\n        s = s + w[3] * f.register_file_pressure\n        s = s + w[4] * f.shared_memory_pressure\n        s = s + w[5] * f.resident_block_scarcity\n        s = s + w[6] * f.wave_count_deficit\n        s = s + w[7] * f.thread_work_granularity_deficit\n        s = s + w[8] * f.splitk_sm_latency_rounds_log\n    else:\n        s = s + w[9] * f.splitk_roofline_log_time\n        # Long reductions expose steady-state K-loop work; retain separate\n        # resource terms in the compute-bound path for tiles whose iteration\n        # advantage is lost to register or shared-memory pressure.\n        if p.log_min_dim >= 7:\n            if p.roofline_ratio < 1:\n                s = s + w[10] * np.log2(f.mainloop_iteration_count)\n                s = s + w[11] * f.pipeline_fill_drain_fraction\n                s = s + w[12] * f.k_tail_waste\n            else:\n                s = s + w[13] * np.log2(f.mainloop_iteration_count)\n                s = s + w[14] * f.pipeline_fill_drain_fraction\n                s = s + w[15] * np.log2(f.tm_crit_ratio)\n                s = s + w[16] * np.log2(f.tm_l2_ratio)\n                s = s + w[17] * f.k_tail_waste\n\n    s = s + 0.001 * sgn * f.tm_log_inst\n    return s",
