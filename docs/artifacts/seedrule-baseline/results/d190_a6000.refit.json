    "code": "def score(f, p, hw, w):\n    # Boundary overcompute grows with the logarithm of tile edge waste.\n    s = np.log2(1.0 + f.edge_waste) * w[0]\n    # A nearly empty final CTA wave loses useful machine throughput.\n    s = s + f.tail_waste * w[1]\n    # One-wave or otherwise poorly amortized grids expose scheduling startup.\n    s = s + f.wave_count_deficit * w[2]\n    # CTA dispatch cost is fixed per CTA, so compress its wide normalized range.\n    s = s + np.log2(1.0 + f.dispatch_overhead_per_flop) * w[3]\n    # Local-memory spill traffic is an especially expensive extra data path.\n    s = s + np.log2(1.0 + f.spill_traffic_ratio) * w[4]\n    # Short pipelines expose fill and drain overhead regardless of roofline regime.\n    s = s + f.pipeline_fill_drain_fraction * w[5]\n    if p.roofline_ratio < 1:\n        # In the bandwidth regime, replicated operand traffic is the primary cost.\n        s = s + np.log2(1.0 + f.operand_tile_traffic_ratio) * w[6]\n        # Poor tile coalescing directly increases global-memory transactions.\n        s = s + np.log2(1.0 + f.coalescing_stride_ratio) * w[7]\n        # Lost raster locality removes cache reuse and raises memory traffic.\n        s = s + f.raster_locality_deficit * w[8]\n        # Low tile arithmetic intensity makes each fetched byte less productive.\n        s = s + f.tile_roofline_deficit * w[9]\n        # Parallel split-K partial materialization adds bandwidth demand.\n        s = s + f.parallel_reduction_traffic_fraction * w[10]\n    else:\n        # In the compute regime, unfilled thread slots reduce latency hiding.\n        s = s + f.occupancy_deficit * w[11]\n        # Register allocation pressure limits resident work and issue hiding.\n        s = s + f.register_file_pressure * w[12]\n        # Instruction work per useful arithmetic competes with tensor issue slots.\n        s = s + np.log2(1.0 + f.instruction_density) * w[13]\n        # Serial split-K dependencies reduce independent accumulator work.\n        s = s + f.serial_reduction_dependency * w[14]\n        # Extra parallel-reduction arithmetic is paid on a compute-bound path.\n        s = s + f.parallel_reduction_compute_fraction * w[15]\n    return s",
